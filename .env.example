# MongoDB Configuration
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name
# For Local: mongodb://localhost:27017/database_name
MONGODB_CONNECTION_URL=mongodb://localhost:27017/srs

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (if used)
JWT_SECRET=your_jwt_secret_here

# AWS Configuration (if using S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your_bucket_name

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Clerk or Auth Configuration (if applicable)
CLERK_API_KEY=your_clerk_api_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Other API Keys
DESCRIPT_API_KEY=your_descope_key
